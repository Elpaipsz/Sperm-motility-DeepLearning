*.pyc
.ipynb_checkpoints/
*.log
.claude/
.vscode/
.DS_Store
Thumbs.db
~$*.docx

# ---------------------------------------------------------------------------
# Secretos: nunca versionar claves ni credenciales
# ---------------------------------------------------------------------------
.env
*.key
secrets*

# ---------------------------------------------------------------------------
# SÍ se versiona: estimacion_motilidad_visem.ipynb, README.md, src/, requirements.txt, AGENTS.md,
